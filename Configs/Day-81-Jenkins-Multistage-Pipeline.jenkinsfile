pipeline {
    agent { label 'stapp01' }

    stages {

        stage('Deploy') {
            steps {
                script {
                    sh '''
                    cd /var/www/html
                    git pull origin master
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh '''
                    curl -f http://stlb01:8091
                    '''
                }
            }
        }
    }
}
